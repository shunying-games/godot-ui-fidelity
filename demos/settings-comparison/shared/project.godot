config_version=5

[application]
config/name="Mosslight Atelier - UI Study"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="GodotUIFidelityDemo/isolated-20261016"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045,0.09,0.105,1)

[audio]
driver/enable_input=false
driver/mix_rate=22050
